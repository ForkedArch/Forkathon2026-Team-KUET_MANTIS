# Set to "production" (or anything other than "development") to require a
# real SECRET_KEY. Outside of development the app will refuse to start if
# SECRET_KEY is not set.
ENVIRONMENT=development

# JWT signing key. REQUIRED outside development — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

DATABASE_URL=sqlite:///./campus_share.db

ALLOWED_ORIGINS=http://localhost:5173

UPLOAD_DIR=./uploads
