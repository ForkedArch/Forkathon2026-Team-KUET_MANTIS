# ==============================================================================
# CampusShare KUET - Production Environment Configuration
# ==============================================================================

# Set to "production" to enforce security checks (e.g. mandatory SECRET_KEY)
ENVIRONMENT=production

# JWT signing secret key (REQUIRED in production)
# Generate a strong 64-char key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string

# Algorithm & access token lifetime (minutes)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL
# SQLite default (with persistent volume): sqlite:////app/data/campus_share.db
# Or PostgreSQL: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./campus_share.db

# Comma-separated allowed frontend origins (NO trailing slashes)
# Include your web production domain, Vercel/Netlify previews, and local testing origins
ALLOWED_ORIGINS=https://campusshare.yourdomain.com,https://campusshare.vercel.app,http://localhost

# Directory for item upload images
UPLOAD_DIR=./uploads
